{
  "name": "halo",
  "productName": "Windows Island",
  "version": "2.5.8",
  "description": "HALO - a Dynamic Island for Windows (music, browser media, notifications, timer)",
  "main": "main.js",
  "author": {
    "name": "hworks",
    "email": "ecchworks@gmail.com"
  },
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "rcedit": "^4.0.1"
  },
  "build": {
    "appId": "com.hworks.halo",
    "productName": "HALO",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "tags.js",
      "renderer/**/*",
      "build/icon.png"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "HALO",
      "include": "build/installer.nsh",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "deleteAppDataOnUninstall": false
    },
    "afterPack": "./afterPack.js",
    "extraResources": [
      {
        "from": "helpers",
        "to": "helpers"
      }
    ],
    "copyright": "Copyright © hworks",
    "artifactName": "HALO-Setup.${ext}"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "electron-updater": "^6.3.9"
  }
}